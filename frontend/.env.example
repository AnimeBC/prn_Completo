# URL del backend (Express + PostgreSQL + Redis)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google OAuth — Client ID de Google Cloud Console (tipo "Aplicación web")
# Debe ser el MISMO valor que GOOGLE_CLIENT_ID en backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ExoClick In-Stream (VAST) — anuncio post-roll al terminar el video
NEXT_PUBLIC_VAST_TAG=https://s.magsrv.com/v1/vast.php?idz=6029702
